generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  wechatOpenId  String?  @unique
  wechatName    String?
  wechatAvatar  String?
  role          String   @default("user")
  plan          String   @default("free")
  quota         Int      @default(5)
  totalUsed     Int      @default(0)
  planExpiresAt DateTime?
  createdAt     DateTime @default(now())
  jobs          Job[]
  topups        Topup[]
  orders        Order[]
  redeemedCodes RedemptionCode[]
}

model Job {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputText  String
  outputText String?
  status     String    @default("PENDING")
  inputLen   Int?
  outputLen  Int?
  error      String?
  createdAt  DateTime  @default(now())
  doneAt     DateTime?

  @@index([userId])
}

model Topup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  price     Float
  planKey   String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Config {
  key   String @id
  value String
}

model SmsCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  requestIp String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
  @@index([requestIp, createdAt])
}

model Order {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  planKey         String
  amount          Float
  quota           Int
  status          String    @default("PENDING")
  providerTradeNo String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model RedemptionCode {
  id           String    @id @default(uuid())
  codeHash     String    @unique
  codeHint     String
  planKey      String
  quota        Int
  price        Float     @default(0)
  source       String    @default("manual")
  batchId      String?
  note         String?
  redeemedById String?
  redeemedBy   User?     @relation(fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([batchId])
  @@index([redeemedById, redeemedAt])
  @@index([source, createdAt])
}
